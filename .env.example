# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (private bucket for originals)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional: override API base for admin ingest/dev tools (e.g., http://localhost:3000)
VITE_API_BASE_URL=

# Sentry (optional)
# VITE_SENTRY_DSN enables client-side error reporting in production builds.
# SENTRY_AUTH_TOKEN enables hidden source map upload during production builds.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=

# Public preview bucket (S3-compatible)
R2_PREVIEW_BUCKET_NAME=
R2_PREVIEW_PUBLIC_BASE_URL=https://preview.soundroom.live
